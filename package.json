  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@upstash/redis": "^1.38.4",
    "google-auth-library": "^11.3.3",
    "ical.js": "^2.2.1",
    "jwt-decode": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdav": "^2.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.1.0",
    "lucide-react": "^1.37.0",
    "oxlint": "^1.91.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
