{
  "name": "finance-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src api server",
    "preview": "vite preview",
    "test": "vitest run",
    "test:api-runtime": "node scripts/check-api-runtime.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
